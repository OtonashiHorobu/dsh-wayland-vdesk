{
  "name": "dsh-vdesk",
  "version": "0.1.0",
  "description": "Per-conversation off-screen Wayland virtual desktops for DeepSeek Harness: run, screenshot, drive and watch GUI programs without touching the real desktop.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "wayland",
    "virtual-desktop",
    "sway",
    "vnc",
    "computer-use",
    "ui-debugging"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "dsh-vdesk": "src/cli.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "web",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "linux"
  ],
  "dependencies": {
    "ws": "^8.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
